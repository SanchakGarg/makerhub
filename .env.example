# Public URL of this server — used in generated installer scripts AND as the
# OIDC redirect base (BASE_URL/api/auth/callback must be registered in Zitadel
# as a redirect URI, and BASE_URL/ as the post-logout redirect URI).
# Must be reachable from the end user's machine
# Example: http://192.168.1.10:3000 or https://makerhub.yourdomain.com
BASE_URL=http://localhost:3000

# Port to listen on (default: 3000)
PORT=3000

# Zitadel OIDC issuer (no trailing slash). Required for admin login.
# Example: https://auth.yourdomain.com
ZITADEL_ISSUER=

# Zitadel application client ID (public client, PKCE, Token Type = JWT).
ZITADEL_CLIENT_ID=385235406276264966

# Optional: override the expected JWT audience if it differs from
# ZITADEL_CLIENT_ID. Zitadel access tokens often carry the project ID in
# `aud` — decode a real token if login succeeds but every API call 401s.
# ZITADEL_AUDIENCE=

# Optional: force the "Secure" cookie flag on/off. Defaults to whether
# BASE_URL starts with https:// — override only if running behind a
# TLS-terminating reverse proxy where BASE_URL is http://.
# AUTH_COOKIE_SECURE=true

# Directory for admin-written data (uploaded configs, printer edits). Kept
# separate from machines/ (which is git-tracked) so admin edits never
# conflict with `git pull` during an update.
# MAKERHUB_DATA_DIR=/app/data
